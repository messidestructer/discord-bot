# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here
OWNER_ID=your_discord_user_id_here

# ── Roblox ────────────────────────────────────────────────────────────────────
ROBLOX_GROUP_ID=your_roblox_group_id
# Get this from your Roblox bot account's browser cookies (.ROBLOSECURITY)
ROBLOX_COOKIE=your_roblosecurity_cookie

# ── Bloxlink (optional — free tier at blox.link/dashboard) ───────────────────
BLOXLINK_API_KEY=

# ── Discord Channels (right-click channel > Copy ID with Developer Mode on) ──
LOG_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
EVENT_LOG_CHANNEL_ID=
REPORT_CHANNEL_ID=
PROMOTION_CHANNEL_ID=

# ── Discord Roles ─────────────────────────────────────────────────────────────
VERIFIED_ROLE_ID=
EP_MANAGER_ROLE_ID=

# ── Event logging mode ────────────────────────────────────────────────────────
# flexible (default) | screenshot_required | manual_only
LOG_MODE=flexible

# ── Auto-promotion rules (JSON, overrides defaults in promotions.py) ──────────
# Example: [{"min_ep":0,"rank":1,"name":"Recruit"},{"min_ep":10,"rank":5,"name":"Private"}]
PROMOTION_RULES=

# ── Google Sheets (optional — see README) ─────────────────────────────────────
ENABLE_SHEETS=false
GOOGLE_SHEETS_CREDS_FILE=credentials.json
GOOGLE_SHEET_ID=
GOOGLE_EVENT_LOG_TAB=Event Log
GOOGLE_EP_TAB=EP Leaderboard
EP_SYNC_INTERVAL_HOURS=6

# ── Report branding ───────────────────────────────────────────────────────────
REPORT_UNIT_NAME=Your Group Name

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=bot_data.json
